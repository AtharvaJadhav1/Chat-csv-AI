# ---- LLM (leave OPENAI_API_KEY empty to use the offline rule-based planner) ----
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (OpenAI, Azure gateway, Groq, Ollama, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ---- Limits ----
MAX_FILE_SIZE_MB=25
MAX_ROWS=100000
DATASET_TTL_MINUTES=120

# ---- Networking ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
